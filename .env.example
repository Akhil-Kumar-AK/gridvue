# Server
PORT=8787
# SQLite file (Postgres adapter is on the roadmap, see ARCHITECTURE.md)
DATABASE_PATH=./data/layr.db
# Max document size accepted by PUT /api/files/:id/doc (bytes)
MAX_DOC_BYTES=20000000
# Max uploaded asset size (bytes)
MAX_ASSET_BYTES=10000000
# Set to 1 behind HTTPS to mark the session cookie Secure
COOKIE_SECURE=0
# AI providers (Phase 6) - intentionally unset; UI shows an honest setup state
ANTHROPIC_API_KEY=

# Extra origins allowed to POST/PUT/PATCH/DELETE (comma separated). Dev default is the Vite server.
TRUSTED_ORIGINS=http://localhost:5273,http://127.0.0.1:5273
