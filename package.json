{
  "name": "layr-design",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm-run-all2 --parallel dev:server dev:web",
    "dev:server": "npm run dev -w @layr/server",
    "dev:web": "npm run dev -w @layr/web",
    "build": "npm run build -w @layr/web",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "seed": "npm run seed -w @layr/server",
    "bench": "tsx scripts/bench.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "npm-run-all2": "8.0.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
